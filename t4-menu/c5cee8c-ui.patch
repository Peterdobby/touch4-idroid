diff --git a/plat-a4/t4_diag.c b/plat-a4/t4_diag.c
new file mode 100644
index 0000000..3242de9
--- /dev/null
+++ b/plat-a4/t4_diag.c
@@ -0,0 +1,54 @@
+#include "openiboot.h"
+#include "commands.h"
+#include "framebuffer.h"
+#include "lcd.h"
+#include "util.h"
+#include "t4_diag.h"
+
+/* No heap, printf or scheduler access before tasks_setup. These records are
+ * ordinary RAM and are printed when the existing console becomes available. */
+static struct { const char *name; int result; } trace[48];
+static unsigned trace_count;
+static int ready;
+int t4_display_result = -999;
+int t4_framebuffer_result = -999;
+
+void t4_mark(const char *name, int result)
+{
+    if(trace_count < 48) {
+        trace[trace_count].name = name;
+        trace[trace_count++].result = result;
+    }
+    if(ready) bufferPrintf("[T4] %s ret=%d\n", name, result);
+}
+
+void t4_trace_ready(void) { ready = 1; }
+
+void t4_trace_dump(void)
+{
+    unsigned i;
+#ifdef T4_MENU_01
+    bufferPrintf("[T4] build=T4_MENU_01\n");
+#else
+    bufferPrintf("[T4] build=T4_DIAG_01\n");
+#endif
+    bufferPrintf("[T4] trace begin: %s\n", OPENIBOOT_VERSION_STR);
+    for(i = 0; i < trace_count; i++)
+        bufferPrintf("[T4] %s ret=%d\n",trace[i].name,trace[i].result);
+    bufferPrintf("[T4] display_result=%d framebuffer_result=%d FramebufferHasInit=%d\n",
+                 t4_display_result,t4_framebuffer_result,FramebufferHasInit);
+    if(FramebufferHasInit && currentWindow)
+        bufferPrintf("[T4] framebuffer=%p width=%d height=%d stride=%d colorspace=%d\n",
+                     currentWindow->framebuffer.buffer,currentWindow->framebuffer.width,
+                     currentWindow->framebuffer.height,currentWindow->framebuffer.lineWidth,
+                     currentWindow->framebuffer.colorSpace);
+    bufferPrintf("[T4] trace end\n");
+}
+
+static error_t cmd_t4_diag(int argc, char **argv)
+{
+    (void)argc; (void)argv;
+    t4_trace_dump();
+    return SUCCESS;
+}
+COMMAND("t4_diag", "Print RAM-only T4 initialization trace.", cmd_t4_diag);
