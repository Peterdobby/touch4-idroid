 static void menu_run(uint32_t _V)
 {
+#ifdef T4_MENU_01
+	/* Keep upstream GPIO/button initialization. Poll pressed state on edges;
+	 * the upstream !buttons_is_pushed(volume) repeats while NOT pressed. */
+	int prev_down = buttons_is_pushed(BUTTONS_VOLDOWN);
+	int prev_up = buttons_is_pushed(BUTTONS_VOLUP);
+	int prev_hold = buttons_is_pushed(BUTTONS_HOLD);
+	int prev_home = buttons_is_pushed(BUTTONS_HOME);
+	(void)_V;
+	t4_mark("menu button task running", 0);
+	while(TRUE) {
+		int down = buttons_is_pushed(BUTTONS_VOLDOWN);
+		int up = buttons_is_pushed(BUTTONS_VOLUP);
+		int hold = buttons_is_pushed(BUTTONS_HOLD);
+		int home = buttons_is_pushed(BUTTONS_HOME);
+		if((down && !prev_down) || (hold && !prev_hold)) {
+			setup_entry(setup_current()->list_ptr.next);
+			menu_draw();
+		} else if(up && !prev_up) {
+			setup_entry(setup_current()->list_ptr.prev);
+			menu_draw();
+		}
+		if(home && !prev_home) {
+			bufferPrintf("[T4] Home: UI ONLY, activation disabled\n");
+			t4_menu_status();
+		}
+		prev_down=down; prev_up=up; prev_hold=hold; prev_home=home;
+		udelay(20000);
+		task_yield();
+	}
+#else
 	while(TRUE)
 	{
 #ifdef BUTTONS_VOLDOWN
@@ -136,6 +196,7 @@ static void menu_run(uint32_t _V)
 
 		task_yield();
 	}
+#endif
 }
 
