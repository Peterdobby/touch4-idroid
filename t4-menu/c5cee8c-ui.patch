diff --git a/mk8900image/SConscript b/mk8900image/SConscript
index 0db5375..9bde21e 100644
--- a/mk8900image/SConscript
+++ b/mk8900image/SConscript
@@ -1,28 +1,23 @@
-Import("*")
-
-import platform
-
-libs = []
-if platform.system() == 'Linux':
-	if platform.machine() == 'x86_64':
-		libs += ["x86_64/libxpwn.a", "x86_64/libcommon.a"]
-	else:
-		libs += ["x86/libxpwn.a", "x86/libcommon.a"]
-
-if platform.system() == 'Darwin':
-	libs += ["mac-x86/libxpwn.a", "mac-x86/libcommon.a"]
-
-mk8900image = henv.Program('mk8900image', ['mk8900image.c'] + libs, LIBPATH='/usr/X11/lib', LIBS=['m', 'dl', 'png', 'crypto', 'z'])
-
-def generate_actions(source, target, env, for_sig=False, **kw):
-	Depends(target, mk8900image)
-
-	if len(source) > 2:
-		return "%s %s %s %s %s" % (str(mk8900image[0]), source[0], target[0], source[1], source[2])
-
-	if len(source) > 1:
-		return "%s %s %s %s" % (str(mk8900image[0]), source[0], target[0], source[1])
-	
-	return "%s %s %s" % (str(mk8900image[0]), source[0], target[0])
-
-env.Append(BUILDERS = {'Make8900Image': Builder(generator=generate_actions)})
+Import('*')
+import struct
+def flatten(target, source, env):
+    data = open(str(source[0]), 'rb').read()
+    if data[:6] != b'\x7fELF\x01\x01':
+        raise ValueError('Expected ELF32 little endian')
+    entry, phoff = struct.unpack_from('<II', data, 24)
+    size, count = struct.unpack_from('<HH', data, 42)
+    headers = [struct.unpack_from('<8I', data, phoff+i*size) for i in range(count)]
+    extent = max(p[2]+p[5]-entry for p in headers)
+    if entry != 0 or not 0 < extent < 0x1000000:
+        raise ValueError('Unexpected N81AP layout')
+    image = bytearray(extent)
+    for p in headers:
+        if not p[4]:
+            continue
+        offset = p[2]-entry
+        if offset < 0 or offset+p[4] > extent or p[1]+p[4] > len(data):
+            raise ValueError('Invalid segment')
+        image[offset:offset+p[4]] = data[p[1]:p[1]+p[4]]
+    open(str(target[0]), 'wb').write(image)
+    return 0
+env.Append(BUILDERS={'Make8900Image': Builder(action=flatten)})
