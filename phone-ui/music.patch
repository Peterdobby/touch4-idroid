 bool MusicPlayer::run(void)
 {
+    // the folder is read again each time: files arrive while the system runs
+    bsp_extra_file_instance_init(MUSIC_DIR, &_file_iterator);
+    if (file_iterator_get_count(_file_iterator) == 0) {
+        lv_obj_t *label = lv_label_create(lv_scr_act());
+        lv_label_set_text(label, "No MP3 files in " MUSIC_DIR);
+        lv_obj_set_style_text_font(label, &lv_font_montserrat_22, 0);
+        lv_obj_center(label);
+        return true;
+    }
     lv_demo_music(lv_scr_act(), _file_iterator);
 
     return true;
