-	if (xusbxti && !IS_ERR(xusbxti)) {
-		switch (clk_get_rate(xusbxti)) {
-		case 12*MHZ:
-			osc |= S3C_PHYCLK_CLKSEL_12M;
-			break;
-		case 24*MHZ:
-			osc |= S3C_PHYCLK_CLKSEL_24M;
-			break;
-		default:
-		case 48*MHZ:
-			/* default reference clock */
-			break;
-		}
-		clk_put(xusbxti);
+/* Apple A4 PHY bring-up, following openiBoot c5cee8c (plat-a4/usbphy.c).
+ * The Samsung reference-clock encoding does not apply here. */
+static int s3c_hsotg_a4_phy(struct s3c_hsotg *hsotg)
+{
+	void __iomem *phy = S3C_VA_USB_HSPHY;
+	struct clk *ref;
+	unsigned long rate = 0;
+	u32 sel, id, depth;
+
+	ref = clk_get(hsotg->dev, "xusbxti");
+	if (!IS_ERR(ref)) {
+		rate = clk_get_rate(ref);
+		clk_put(ref);
+	}
+	if (rate == 12000000)
+		sel = 0;
+	else if (rate == 24000000)
+		sel = 1;
+	else if (rate == 48000000)
+		sel = 2;
+	else {
+		dev_err(hsotg->dev, "N81: unknown PHY reference %lu\n", rate);
+		return -ENODEV;
 	}
 
-	writel(osc | 0x10, S3C_PHYCLK);
+	msleep(10);
+	__bic32(hsotg->regs + 0xe00, 3);		/* PCGCCTL: ungate */
+	udelay(100);
+	__orr32(hsotg->regs + S3C_DCTL, S3C_DCTL_SftDiscon);
+	mdelay(4);
 
-	/* issue a full set of resets to the otg and core */
+	writel(0x200, phy + 0x60);
+	writel(0x6, phy + 0x00);
+	writel(0x6, phy + 0x1c);
+	writel(0x733, phy + 0x44);
+	udelay(10);
+	writel((readl(phy + 0x04) & ~3) | sel, phy + 0x04);
+	__orr32(phy + 0x08, 1);
+	udelay(20);
+	__bic32(phy + 0x08, 1);
+	mdelay(1);
 
-	writel(S3C_RSTCON_PHY, S3C_RSTCON);
-	udelay(20);	/* at-least 10uS */
-	writel(0, S3C_RSTCON);
+	id = readl(hsotg->regs + 0x40);
+	depth = readl(hsotg->regs + 0x4c) >> 16;
+	dev_info(hsotg->dev, "N81: core id %08x, fifo depth %u\n", id, depth);
+	if (!id || id == 0xffffffff || id == 0x0bad0add || depth < 1664)
+		return -ENODEV;
+	return 0;
 }
 
