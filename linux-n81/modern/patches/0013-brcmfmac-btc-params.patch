 }
 
+/* Bluetooth coexistence settings, as index,value pairs for "btc_params" */
+static unsigned int brcmf_btc_params[16];
+static int brcmf_btc_count;
+module_param_array_named(btc_params, brcmf_btc_params, uint, &brcmf_btc_count, 0400);
+
+static void brcmf_set_btc_params(struct brcmf_if *ifp)
+{
+	int i;
+
+	for (i = 0; i + 1 < brcmf_btc_count; i += 2) {
+		__le32 pair[2] = { cpu_to_le32(brcmf_btc_params[i]),
+				   cpu_to_le32(brcmf_btc_params[i + 1]) };
+		int ret = brcmf_fil_iovar_data_set(ifp, "btc_params", pair,
+						   sizeof(pair));
+
+		pr_info("brcmfmac: btc_params %u = %u (%d)\n", brcmf_btc_params[i],
+			brcmf_btc_params[i + 1], ret);
+	}
+}
+
