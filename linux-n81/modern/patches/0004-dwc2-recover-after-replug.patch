--- a/drivers/usb/dwc2/gadget.c
+++ b/drivers/usb/dwc2/gadget.c
@@ -3753,6 +3753,13 @@
 
 		dwc2_writel(hsotg, GINTSTS_USBRST, GINTSTS);
 
+		/*
+		 * A bus reset means the link is active again. Without this, a
+		 * replug after the suspend interrupt leaves lx_state at L2 and
